---
import type { LinkButton } from '@/types/shared';
import Icon from './icon.astro';

export interface Props extends Omit<LinkButton, 'url'>, Omit<astroHTML.JSX.HTMLAttributes, 'slot'> {
  url?: LinkButton['url'];
  as?: 'a' | 'button';
  /** Shows the name next to the icon, making the button wider. */
  showName?: boolean;
}

const { name, icon, url, as, showName, ...props } = Astro.props;

const classes = /* tw */ {
  main: 'flex items-center justify-center h-7 rounded text-gray-400 bg-gray-100 dark:bg-gray-600 dark:text-gray-200',
  size: 'w-7',
  wide: 'gap-1.5 px-2.5 text-sm font-medium',
  active: 'active:translate-y-px',
  focus: 'focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500',
};

const Element = as || 'a';
---

<Element
  aria-label={name}
  href={url}
  target="_blank"
  data-tooltip={name}
  class:list={[classes.main, showName ? classes.wide : classes.size, classes.active, classes.focus]}
  {...props}
>
  <Icon name={icon} size={16} />
  {showName && <span>{name}</span>}
</Element>
